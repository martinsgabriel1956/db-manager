{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ordo",
  "version": "0.3.0",
  "identifier": "dev.nemomartins.dbmanager",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ordo",
        "width": 1200,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkwQjdDNEIxODRGMEVEOUEKUldTYTdmQ0VzY1Mza0tVNGk2ZU1zcE1GY1FqR3BCSUxMeVA3NE02UEJLTDlCY2JxVVluZDU3UmgK",
      "endpoints": [
        "https://github.com/martinsgabriel1956/db-manager/releases/latest/download/latest.json"
      ]
    }
  }
}
